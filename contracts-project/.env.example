# Copy to .env (or export) for scripts/deploy.js — NEVER commit a real .env.
# BSC testnet (chainId 97) — deploy here first:
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# BSC mainnet (chainId 56) — deploy.js refuses without CONFIRM_MAINNET=YES:
# RPC_URL=https://bsc-dataseed.binance.org
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
# Testnet/local only: address of a MockAgentID you deployed.
# On mainnet leave unset — the official SPACE ID Agent ID address is the default.
# AGENT_ID_ADDRESS=0x...
# CONFIRM_MAINNET=YES
